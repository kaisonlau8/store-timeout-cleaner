# 复制为 .env 后填入生产凭证。不要提交 .env。
# 也可不填，运行时会回读同级目录 scrm-api/.env。

SCRM_ENV=production
SCRM_BASE_URL=https://scrm.m-hero.com
SCRM_APP_ID=
SCRM_APP_SECRET=

# 已拉机器人只统计这一个账号（刘明轩）。userid 优先，否则按姓名精确匹配。
SCRM_ROBOT_USERIDS=25738
SCRM_ROBOT_USERNAME=刘明轩
SCRM_ROBOT_POSITION=

# 门店超时评分的 LLM 复核。不填则只按确定性规则计分。
# 填写后，点击「运行 LLM 复核」会把客户消息正文发给 DeepSeek，不要把密钥写进仓库。
# DEEPSEEK_API_KEY=
